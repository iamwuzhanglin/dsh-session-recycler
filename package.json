{
  "name": "dsh-session-recycler",
  "version": "0.2.2",
  "description": "Real session deletion for DeepSeek Harness: delete a conversation record from the Web UI, with a trash bin to restore or purge it.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "session-management",
    "trash"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/routes.test.mjs && node test/client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamwuzhanglin/dsh-session-recycler.git"
  },
  "homepage": "https://github.com/iamwuzhanglin/dsh-session-recycler#readme",
  "bugs": "https://github.com/iamwuzhanglin/dsh-session-recycler/issues"
}
